# Patrulla Antimosquito · vhost Apache de ejemplo
# Requiere: mod_ssl, mod_headers, mod_deflate, mod_expires (y mod_http2 si se usa h2).
# Ajustar dominios, rutas de certificado y logs antes de aplicar.
#
# Estructura de deploy recomendada:
#   /var/www/patrulla/releases/20261106T120000/
#   /var/www/patrulla/current -> releases/20261106T120000
#
# DocumentRoot apunta a `current`. El deploy copia a una release nueva y
# cambia el symlink de forma atómica.

<VirtualHost *:80>
    ServerName patrulla.example.org
    Redirect permanent / https://patrulla.example.org/
</VirtualHost>

<VirtualHost *:443>
    ServerName patrulla.example.org
    DocumentRoot /var/www/patrulla/current

    Protocols h2 http/1.1
    SSLEngine on
    SSLCertificateFile      /etc/letsencrypt/live/patrulla.example.org/fullchain.pem
    SSLCertificateKeyFile   /etc/letsencrypt/live/patrulla.example.org/privkey.pem

    AddDefaultCharset UTF-8
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2

    <Directory /var/www/patrulla/current>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
        DirectoryIndex index.html
    </Directory>

    # Cabeceras de seguridad
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
    Header always set X-Frame-Options "DENY"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

    # Páginas y configuración: revalidar siempre.
    <FilesMatch "^(index|admin|admin-reportes)\.html$|^(config\.js|sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # Assets: cache corta. Subir a 1 año si se hashean los nombres.
    <FilesMatch "\.(css|woff2|png|jpe?g|svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # No servir dotfiles ni documentación interna.
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    RedirectMatch 404 ^/(README|ADMIN|LICENCIA)

    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml

    ErrorLog  ${APACHE_LOG_DIR}/patrulla-error.log
    CustomLog ${APACHE_LOG_DIR}/patrulla-access.log combined
</VirtualHost>
